# ─── Azure Cosmos DB ──────────────────────────────────────────────────────────
COSMOS_DB_CONNECTION_STRING=           # Azure Cosmos DB primary connection string
COSMOS_DB_DATABASE_NAME=vitiligo_db    # The database name in Cosmos DB

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=                            # Random 64-character string for signing JWT tokens
JWT_EXPIRES_IN_DAYS=7                  # Token expiry in days

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000                              # Backend server port
ALLOWED_ORIGINS=*                      # Comma-separated allowed origins for CORS

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                        # OpenAI API key for AI insights
